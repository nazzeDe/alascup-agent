{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolResult",
  "type": "object",
  "required": ["execution_status"],
  "properties": {
    "execution_status": {"type": "string", "enum": ["SUCCEEDED", "FAILED", "REJECTED"]},
    "backup_ref": {"type": ["string", "null"]},
    "output": {"type": ["object", "array", "string", "number", "boolean", "null"]},
    "error": {"type": ["object", "null"]},
    "execution_time_ms": {"type": ["integer", "null"]}
  },
  "additionalProperties": true
}
