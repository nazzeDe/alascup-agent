{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolCall",
  "type": "object",
  "required": ["name", "server", "chat_id", "params", "approval_status", "execution_status", "timestamp"],
  "properties": {
    "name": {"type": "string"},
    "tool_name": {"type": "string"},
    "server": {"type": "string", "enum": ["tool-server"]},
    "description": {"type": "string"},
    "is_read_only": {"type": "boolean"},
    "is_rollbackable": {"type": "boolean"},
    "params_schema": {"type": "object"},
    "chat_id": {"type": "string", "format": "uuid"},
    "message_id": {"type": ["string", "null"], "format": "uuid"},
    "call_id": {"type": ["string", "null"], "format": "uuid"},
    "llm_trace_id": {"type": ["string", "null"], "format": "uuid"},
    "llm_tool_call_id": {"type": ["string", "null"]},
    "params": {"type": "object"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "approval_status": {"type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED"]},
    "execution_status": {"type": "string", "enum": ["PENDING_APPROVAL", "RUNNING", "SUCCEEDED", "FAILED"]},
    "error": {"type": ["object", "null"]},
    "result": {"type": ["object", "null"]},
    "timestamp": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
