{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolRequest",
  "type": "object",
  "required": ["request_id", "message_id", "chat_id", "name", "server", "params", "approval_status", "created_at"],
  "properties": {
    "name": {"type": "string"},
    "server": {"type": "string", "enum": ["tool-server"]},
    "description": {"type": "string"},
    "is_read_only": {"type": "boolean"},
    "is_rollbackable": {"type": "boolean"},
    "params_schema": {"type": "object"},
    "request_id": {"type": "string", "format": "uuid"},
    "message_id": {"type": "string", "format": "uuid"},
    "chat_id": {"type": "string", "format": "uuid"},
    "params": {"type": "object"},
    "approval_status": {"type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "expired_at": {"type": ["string", "null"], "format": "date-time"},
    "rejected_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
