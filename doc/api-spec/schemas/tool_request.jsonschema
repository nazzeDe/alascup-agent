{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolRequest",
  "type": "object",
  "required": ["request_id", "message_id", "chat_id", "tool_name", "status", "created_at"],
  "properties": {
    "request_id": {"type": "string"},
    "message_id": {"type": "string"},
    "chat_id": {"type": "string"},
    "tool_name": {"type": "string"},
    "params": {"type": ["object","array","string","null"]},
    "requester_id": {"type": "string"},
    "status": {"type": "string", "enum": ["pending", "approved", "rejected", "executing", "completed", "failed"]},
    "created_at": {"type": "string", "format": "date-time"},
    "approved_at": {"type": ["string","null"], "format": "date-time"},
    "approver_id": {"type": ["string","null"]},
    "decision_reason": {"type": ["string","null"]},
    "result": {"type": ["object","null"]}
  },
  "additionalProperties": false
}
