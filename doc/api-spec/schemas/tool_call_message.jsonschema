{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ToolCallMessage",
  "type": "object",
  "required": ["message_id", "chat_id", "request_id", "tool_name", "params", "timestamp"],
  "properties": {
    "message_id": {"type": "string", "format": "uuid"},
    "chat_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string"},
    "tool_name": {"type": "string"},
    "params": {"type": ["object","array","string","null"]},
    "is_read_only": {"type": "boolean", "default": false},
    "is_rollbackable": {"type": "boolean", "default": false},
    "metadata": {"type": "object"},
    "timestamp": {"type": "string", "format": "date-time"},
    "author": {"type": "string"}
  },
  "additionalProperties": false
}
