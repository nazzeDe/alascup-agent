{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@latest",
        "--headless",
        "--executable-path",
        "/usr/bin/chromium",
        "--allowed-hosts",
        "localhost"
      ],
      "env": {}
    }
  }
}