// syscount.bt — 系统调用频率统计 (3秒窗口后退出)
// 输出: { "event": "start|done" }, { "comm": "...", "syscall_id": N, "count": N }

BEGIN
{
    printf("{\"event\":\"start\",\"duration_s\":3}\n");
}

tracepoint:raw_syscalls:sys_enter
{
    @syscall_count[comm, args->id] = count();
}

interval:s:3
{
    print(@syscall_count);
    clear(@syscall_count);
    printf("{\"event\":\"done\"}\n");
    exit();
}
