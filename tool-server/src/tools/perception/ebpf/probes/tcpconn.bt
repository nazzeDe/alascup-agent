// tcpconn.bt — 追踪新的 TCP 连接 (持续模式)
// 输出: timestamp_ns, pid, comm, saddr, daddr, dport

kprobe:tcp_connect
{
    $sk = (struct sock *)arg0;
    printf("{\"timestamp_ns\":%llu,\"pid\":%d,\"comm\":\"%s\",\"saddr\":\"%s\",\"daddr\":\"%s\",\"dport\":%d}\n",
        nsecs, pid, comm,
        ntop(AF_INET, $sk->__sk_common.skc_rcv_saddr),
        ntop(AF_INET, $sk->__sk_common.skc_daddr),
        ntohs($sk->__sk_common.skc_dport));
}
