// tcpdrop.bt — TCP 丢包诊断 (10秒窗口后退出) [generic: tcp_drop]
// 输出: { "event": "start|done" }, { "timestamp_ns":N, "pid":N, "comm":"..." }

BEGIN
{
    printf("{\"event\":\"start\",\"duration_s\":10}\n");
}

kprobe:tcp_drop
{
    printf("{\"timestamp_ns\":%llu,\"pid\":%d,\"comm\":\"%s\"}\n",
        nsecs, pid, comm);
}

interval:s:10
{
    printf("{\"event\":\"done\"}\n");
    exit();
}
