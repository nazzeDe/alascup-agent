// tcpconn.bt — 追踪新的 TCP 连接 (持续模式)
// 输出: timestamp_ns, pid, comm, saddr, daddr, dport

kprobe:tcp_connect
{
    $sk = (struct sock *)arg0;
    printf("{\"timestamp_ns\":%llu,\"pid\":%d,\"comm\":\"%s\",\"saddr\":\"%s\",\"daddr\":\"%s\",\"dport\":%d}\n",
        nsecs, pid, comm,
        ntop(2, $sk->__sk_common.skc_rcv_saddr),
        ntop(2, $sk->__sk_common.skc_daddr),
        (($sk->__sk_common.skc_dport & 0xff) << 8) | (($sk->__sk_common.skc_dport >> 8) & 0xff));
}
