// syscall_slow.bt — 检测延迟超过 100μs 的慢系统调用 (5秒窗口后退出)
// 输出: { "event": "start|done" }, { "timestamp_ns":N, "pid":N, "comm":"...", "latency_ns":N }

BEGIN
{
    printf("{\"event\":\"start\",\"threshold_ns\":100000,\"duration_s\":5}\n");
}

tracepoint:syscalls:sys_enter_*
{
    @start[tid] = nsecs;
}

tracepoint:syscalls:sys_exit_*
/@start[tid]/
{
    $lat = nsecs - @start[tid];
    if ($lat > 100000) {
        printf("{\"timestamp_ns\":%llu,\"pid\":%d,\"comm\":\"%s\",\"syscall_id\":%d,\"latency_ns\":%ld}\n",
            nsecs, pid, comm, args->id, $lat);
    }
    delete(@start[tid]);
}

interval:s:5
{
    printf("{\"event\":\"done\"}\n");
    exit();
}
